{
  "manifest_version": 3,
  "name": "AccessOwl Notion Workflow Recorder",
  "description": "Records a redacted Notion-style admin workflow for turning browser actions into Playwright automation hints.",
  "version": "0.1.0",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Workflow Recorder"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["tabs", "activeTab"],
  "host_permissions": [
    "https://www.notion.so/*",
    "https://notion.so/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.notion.so/*",
        "https://notion.so/*"
      ],
      "js": ["recorder-utils.js", "content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
